# CampusConnect Environment Variables Template
# Copy this file to .env and configure as needed

# Database:
# For local SQLite development (default):
DATABASE_URL=sqlite:///./campusconnect.db

# For production PostgreSQL (e.g. Render, Railway, Supabase):
# DATABASE_URL=postgresql://username:password@localhost:5432/campusconnect_db

# Security & JWT
SECRET_KEY=campusconnect_super_secret_jwt_key_2026_replace_with_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base URL for QR Verification Links
BASE_URL=http://localhost:5173

# Optional: Transactional Email / SMTP Delivery
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@campusconnect.edu

